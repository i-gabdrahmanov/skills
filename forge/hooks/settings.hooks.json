{
  "_comment": "Эталон блока hooks для gigacode3 control-plane под PDLC v3.5. ${PROJECT_ROOT} и ${PYTHON} — плейсхолдеры, resolve_hook_paths.py подставляет реальный путь проекта и рабочий python-интерпретатор (sys.executable), кроссплатформенно. Порядок в массивах значим; блокирующие на PreToolUse идут sequential. disableAllHooks не трогать.",
  "hooks": {
    "PreToolUse": [
      {"matcher": "^(run_shell_command|Bash)$", "sequential": true, "hooks": [
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/destructive-blocker.py", "name": "destructive-blocker"},
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/fork-syntax-guard.py", "name": "fork-syntax-guard"},
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/pii-boundary.py", "name": "pii-boundary"},
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/state-write-guard.py", "name": "state-write-guard"},
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/sod-enforcer.py", "name": "sod-enforcer"},
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/inline-phase-guard.py", "name": "inline-phase-guard"},
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/gate-guard.py", "name": "gate-guard"}
      ]},
      {"matcher": "^(write_file|edit|notebook_edit|Write|Edit|WriteFile|NotebookEdit)$", "sequential": true, "hooks": [
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/pii-boundary.py", "name": "pii-boundary"},
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/state-write-guard.py", "name": "state-write-guard"},
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/tdd-guard.py", "name": "tdd-guard"},
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/eval-guard.py", "name": "eval-guard"},
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/sod-enforcer.py", "name": "sod-enforcer"},
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/inline-phase-guard.py", "name": "inline-phase-guard"},
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/gate-guard.py", "name": "gate-guard"}
      ]},
      {"matcher": "^(read_file|Read|ReadFile)$", "hooks": [
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/grounding-evidence.py", "name": "grounding-evidence"}
      ]}
    ],
    "PostToolUse": [
      {"matcher": "^(read_file|web_fetch|run_shell_command|Read|ReadFile|Fetch|WebFetch|Bash)$", "hooks": [
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/prompt-guard.py", "name": "prompt-guard"}
      ]},
      {"matcher": "^(write_file|edit|notebook_edit|Write|Edit|WriteFile|NotebookEdit|run_shell_command|Bash)$", "hooks": [
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/file-journal.py", "name": "file-journal"}
      ]}
    ],
    "UserPromptSubmit": [
      {"hooks": [
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/prompt-guard.py", "name": "prompt-guard"}
      ]}
    ],
    "SubagentStart": [
      {"matcher": "*", "hooks": [
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/context-injector.py", "name": "context-injector"}
      ]}
    ],
    "SubagentStop": [
      {"matcher": "*", "hooks": [
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/state-recorder.py", "name": "state-recorder"}
      ]}
    ],
    "Stop": [
      {"sequential": true, "hooks": [
        {"type": "command", "command": "${PYTHON} ${PROJECT_ROOT}/.gigacode/hooks/phase-gate.py", "name": "phase-gate"}
      ]}
    ]
  }
}
